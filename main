import numpy as np
from time import time
from scipy.linalg import expm

def matrix_exponential(M, epsilon=1e-6):
    """
    Compute the matrix exponential e^M using power series without advanced numpy features.

    Parameters:
        M (np.array): Input square matrix of shape (n, n).
        epsilon (float): Desired accuracy (default is 1e-6).

    Returns:
        np.array: The matrix exponential e^M.
    """
    n = len(M)  # Matrix size
    result = identity_matrix(n)  # Start with the identity matrix (e^0 = I)
    term = identity_matrix(n)  # Current term in the series (initially I)
    k = 1  # Counter for the series expansion

    while True:
        term = term @ M  # Multiply the current term by M
        term = divide_matrix_by_scalar(term, k)  # Divide by k
        result = add_matrices(result, term)  # Add the term to the result

        # Check convergence
        if max_norm(term) < epsilon:
            break

        k += 1

    return result

def scale_and_square_exponential(M, epsilon=1e-6):
    """
    Compute the matrix exponential e^M using Scaling and Squaring method.

    Parameters:
        M (np.array): Input square matrix of shape (n, n).
        epsilon (float): Desired accuracy (default is 1e-6).

    Returns:
        np.array: The matrix exponential e^M.
    """
    n = len(M)
    max_norm_value = max_norm(M)
    s = max(0, int(np.log2(max_norm_value)) + 1)
    scaled_M = divide_matrix_by_scalar(M, 2**s)
    eM_scaled = matrix_exponential(scaled_M, epsilon)

    for _ in range(s):
        eM_scaled = eM_scaled @ eM_scaled

    return eM_scaled

def identity_matrix(size):
    """Create an identity matrix of given size."""
    return np.eye(size)

def divide_matrix_by_scalar(matrix, scalar):
    """Divide each element of matrix by a scalar manually."""
    scalar_inv = 1 / scalar  # Divide by multiplying by the inverse
    return matrix * scalar_inv

def add_matrices(A, B):
    """Add two matrices A and B manually."""
    return A + B

def max_norm(A):
    """Compute the maximum absolute row sum norm (infinity norm) manually."""
    return np.max(np.sum(np.abs(A), axis=1))

def read_data(path, delim):
    """Read matrix data from a file with basic cleanup."""
    try:
        matrix = []
        with open(path, 'r') as f:
            lines = f.readlines()
        for line_num, line in enumerate(lines):
            try:
                clean_line = line.strip().replace(delim, ' ').split()
                row = [float(num) for num in clean_line]
                matrix.append(row)
            except ValueError:
                print(f"Skipping invalid line {line_num + 1}: {line.strip()}")
        matrix = np.array(matrix)
        if matrix.shape[0] != matrix.shape[1]:
            raise ValueError("Matrix is not square.")
        return matrix
    except FileNotFoundError:
        print(f"File not found: {path}")
        return np.array([])

if __name__ == "__main__":
    file_path = "exp_data.txt"  # Update to the correct path
    matrix = read_data(file_path, delim=',')
    epsilon = 1e-6  # Desired accuracy

    if matrix.size > 0:
        t_start = time()
        eM = scale_and_square_exponential(matrix, epsilon)
        t_end = time()

        print("Time:", t_end - t_start)
        #print("Matrix M:")
        #for row in matrix:
        #    print(row)
        print("\nMatrix Exponential e^M:")
        print(eM[0][0])
        #for row in eM:
        #    print(row)

        scipy_result = expm(matrix)
        print("Scipy Result:")
        print(scipy_result[0][0])
    else:
        print("No valid matrix to process.")
